{
  "name": "@fengwk/kchart",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Deterministic, offline SVG charts and a controlled Mermaid subset",
  "engines": { "node": ">=22.12" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengwk/html-view-skill.git",
    "directory": "packages/kchart"
  },
  "homepage": "https://github.com/fengwk/html-view-skill/tree/main/packages/kchart#readme",
  "bugs": "https://github.com/fengwk/html-view-skill/issues",
  "keywords": ["charts", "diagrams", "mermaid", "svg", "visualization"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
    "./mermaid": { "types": "./dist/esm/mermaid.d.ts", "default": "./dist/esm/mermaid.js" },
    "./node": { "types": "./dist/esm/node.d.ts", "default": "./dist/esm/node.js" }
  },
  "files": ["dist/", "LICENSE", "NOTICE.md", "README.md", "README.zh-CN.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
